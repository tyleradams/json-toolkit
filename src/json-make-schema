#!/usr/bin/env python3

import json
import sys
import click
import genson

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="json-make-schema")
def main():
    """
    Generate JSON Schema from JSON data.

    Reads JSON data from standard input and generates a JSON Schema
    that describes the structure of the input data.

    \b
    Examples:
      echo '{"name": "John", "age": 30}' | json-make-schema
      json-make-schema < example.json > schema.json
      cat data.json | json-make-schema | jq '.'
    """
    try:
        data = json.load(sys.stdin)
        builder = genson.SchemaBuilder()
        builder.add_object(data)
        schema = builder.to_schema()
        print(json.dumps(schema))
        sys.exit(0)
    except json.JSONDecodeError as e:
        click.echo(f"Error: Invalid JSON input: {e}", err=True)
        sys.exit(1)
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)


if __name__ == "__main__":
    main()
