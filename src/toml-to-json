#!/usr/bin/env python3

import sys
import json
import click
import toml

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="toml-to-json")
def main():
    """
    Convert TOML data from stdin to JSON.

    Reads TOML data from standard input and outputs JSON.

    \b
    Examples:
      echo "key = 'value'" | toml-to-json
      toml-to-json < config.toml > config.json
      cat data.toml | toml-to-json | jq '.'
    """
    try:
        toml_data = toml.loads(sys.stdin.read())
        json.dump(toml_data, sys.stdout, indent=4)
        print()  # Add newline at end
        sys.exit(0)
    except toml.TomlDecodeError as e:
        click.echo(f"Error: Invalid TOML: {e}", err=True)
        sys.exit(1)
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)

if __name__ == "__main__":
    main()
