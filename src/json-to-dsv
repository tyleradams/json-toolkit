#!/usr/bin/env python3

import json
import sys
import click

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="json-to-dsv")
@click.argument('delimiter')
def main(delimiter):
    """
    Convert JSON array to delimiter-separated values.

    Reads a JSON array of arrays from stdin and outputs DSV data using
    the specified delimiter. Each inner array becomes a row.

    \b
    DELIMITER: The delimiter character to use

    \b
    Examples:
      echo '[["a","b"],["c","d"]]' | json-to-dsv ":"
      json-to-dsv ";" < data.json > data.dsv
      cat table.json | json-to-dsv $'\\t' > data.tsv
    """
    try:
        rows = json.load(sys.stdin)
        for row in rows:
            print(delimiter.join([str(e) for e in row]))
        sys.exit(0)
    except json.JSONDecodeError as e:
        click.echo(f"Error: Invalid JSON: {e}", err=True)
        sys.exit(1)
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)

if __name__ == "__main__":
    main()
