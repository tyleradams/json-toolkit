#!/usr/bin/env python3

import json
import sys
import click
import logfmt

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="json-to-logfmt")
def main():
    """
    Convert JSON array to logfmt format.

    Reads a JSON array of objects from stdin and outputs logfmt-formatted
    lines. Each object in the array becomes one logfmt line.

    \b
    Examples:
      echo '[{"key":"value"}]' | json-to-logfmt
      json-to-logfmt < data.json
      cat logs.json | json-to-logfmt
    """
    try:
        d = json.load(sys.stdin)
        if type(d) != list:
            raise Exception("Only lists can be converted to logfmt")

        for l in logfmt.format(*d):
            print(l)
        sys.exit(0)
    except json.JSONDecodeError as e:
        click.echo(f"Error: Invalid JSON: {e}", err=True)
        sys.exit(1)
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)

if __name__ == "__main__":
    main()
