#!/usr/bin/env python3

import csv
import json
import sys
import click

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="csv-to-json")
def main():
    """
    Convert CSV data from stdin to JSON array format.

    Reads CSV data from standard input and outputs a JSON array of arrays.
    Each row in the CSV becomes an array in the output.

    \b
    Examples:
      echo "a,b,c" | csv-to-json
      csv-to-json < data.csv > data.json
      cat file.csv | csv-to-json | jq '.'
    """
    try:
        csv_reader = csv.reader(sys.stdin)
        print(json.dumps(list(csv_reader)))
        sys.exit(0)
    except BrokenPipeError:
        # Handle pipe being closed (e.g., when piped to head)
        sys.stderr.close()
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)


if __name__ == "__main__":
    main()
