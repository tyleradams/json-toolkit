#!/usr/bin/env python3

import json
import sys
import click
import yaml

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="json-to-yaml")
def main():
    """
    Convert JSON data from stdin to YAML.

    Reads JSON data from standard input and outputs YAML.

    \b
    Examples:
      echo '{"a": 1}' | json-to-yaml
      json-to-yaml < config.json > config.yaml
      cat data.json | json-to-yaml
    """
    try:
        data = json.load(sys.stdin)
        yaml_s = yaml.dump(data, default_flow_style=False)
        print(yaml_s, end='')
        sys.exit(0)
    except json.JSONDecodeError as e:
        click.echo(f"Error: Invalid JSON: {e}", err=True)
        sys.exit(1)
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)


if __name__ == "__main__":
    main()
