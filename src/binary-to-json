#!/usr/bin/env python3

import json
import sys
import click

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="binary-to-json")
def main():
    """
    Convert binary data from stdin to JSON array format.

    Reads binary data from standard input and outputs a JSON array where
    each element is a byte value (0-255).

    \b
    Examples:
      echo "hello" | binary-to-json
      binary-to-json < file.bin > file.json
      cat image.png | binary-to-json | jq '.'
    """
    try:
        data = list(sys.stdin.buffer.read())
        print(json.dumps(data))
        sys.exit(0)
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)

if __name__ == "__main__":
    main()
