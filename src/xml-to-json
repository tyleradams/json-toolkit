#!/usr/bin/env python3

import json
import sys
import click
import xmltodict

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="xml-to-json")
def main():
    """
    Convert XML data from stdin to JSON.

    Reads XML data from standard input and outputs JSON representation
    of the XML structure.

    \b
    Examples:
      echo '<root><item>value</item></root>' | xml-to-json
      xml-to-json < data.xml > data.json
      cat config.xml | xml-to-json | jq '.'
    """
    try:
        xml_string = sys.stdin.read()
        data = xmltodict.parse(xml_string)
        print(json.dumps(data))
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)

if __name__ == "__main__":
    main()
