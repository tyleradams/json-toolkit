#!/usr/bin/env python3

import copy
import json
import sys
import click
import unidiff

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

def hunk_to_d(h):
    d = copy.deepcopy(h.__dict__)
    d["source"] = h.source
    d["target"] = h.target
    return d

def patch_to_d(p):
    d = copy.deepcopy(p.__dict__)
    d["hunks"] = [hunk_to_d(h) for h in p]
    return d

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="diff-to-json")
def main():
    """
    Convert unified diff format from stdin to JSON.

    Reads unified diff data (patch format) from standard input and outputs
    a structured JSON representation of the patches and hunks.

    \b
    Examples:
      git diff | diff-to-json
      diff -u old.txt new.txt | diff-to-json
      diff-to-json < changes.patch | jq '.'
    """
    try:
        patch_set = unidiff.PatchSet(sys.stdin.read())
        o = [patch_to_d(p) for p in patch_set]
        print(json.dumps(o))
        sys.exit(0)
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)

if __name__ == "__main__":
    main()
