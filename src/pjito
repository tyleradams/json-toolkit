#!/usr/bin/env python3

import sys
import click

CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}

PROGRAM = """\
#!/usr/bin/env python3

import json
import sys

def t(data):
    return data

print(json.dumps(t(json.load(sys.stdin))))
"""

@click.command(context_settings=CONTEXT_SETTINGS)
@click.version_option("1.1.0", prog_name="pjito")
def main():
    """
    Generate a Python JSON "Input-Transform-Output" (PJITO) template.

    Outputs a Python script template that reads JSON from stdin, transforms
    it with a function, and outputs JSON. You can edit the transform function
    to process JSON data.

    \b
    Examples:
      pjito > fix-data && chmod +x fix-data
      pjito > transform.py
    """
    try:
        print(PROGRAM, end="")
        sys.exit(0)
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)

if __name__ == "__main__":
    main()
